generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Roles
enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  OPERATIONS
  FINANCE
  VIEWER
}

// Customer Status
enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  BLACKLISTED
}

// Quotation Status
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

// Activity Types
enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  STATUS_CHANGE
  DOCUMENT_ADDED
  FOLLOW_UP
}

// Transport Modes
enum TransportMode {
  AIR
  SEA
  ROAD
  RAIL
  MULTIMODAL
}

// Incoterms
enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

// Users Table
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          UserRole  @default(SALES_REP)
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  customers     Customer[]
  quotations    Quotation[]
  activities    Activity[]
  auditLogs     AuditLog[]

  @@map("users")
}

// Customers Table
model Customer {
  id                  String         @id @default(uuid())
  companyName         String         @map("company_name")
  contactName         String?        @map("contact_name")
  email               String
  phone               String?
  mobile              String?
  address             String?
  city                String?
  country             String         @default("Türkiye")
  postalCode          String?        @map("postal_code")
  taxNumber           String?        @map("tax_number")
  taxOffice           String?        @map("tax_office")
  status              CustomerStatus @default(PROSPECT)
  assignedToId        String?        @map("assigned_to_id")
  notes               String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  assignedTo          User?          @relation(fields: [assignedToId], references: [id])
  quotations          Quotation[]
  activities          Activity[]

  @@map("customers")
}

// Quotations Table
model Quotation {
  id                  String          @id @default(uuid())
  quoteNumber         String          @unique @map("quote_number")
  customerId          String          @map("customer_id")
  createdById         String          @map("created_by_id")
  status              QuotationStatus @default(DRAFT)
  
  // Route Information
  originCity          String          @map("origin_city")
  originCountry       String          @map("origin_country")
  destinationCity     String          @map("destination_city")
  destinationCountry  String          @map("destination_country")
  transportMode       TransportMode   @map("transport_mode")
  incoterm            Incoterm?
  
  // Cargo Details
  cargoDescription    String?         @map("cargo_description")
  weightKg            Decimal?        @map("weight_kg") @db.Decimal(10, 2)
  volumeM3            Decimal?        @map("volume_m3") @db.Decimal(10, 2)
  packagesCount       Int?            @map("packages_count")
  
  // Pricing
  freightCost         Decimal?        @map("freight_cost") @db.Decimal(12, 2)
  originCharges       Decimal?        @map("origin_charges") @db.Decimal(12, 2)
  destinationCharges  Decimal?        @map("destination_charges") @db.Decimal(12, 2)
  insuranceCost       Decimal?        @map("insurance_cost") @db.Decimal(12, 2)
  totalCost           Decimal?        @map("total_cost") @db.Decimal(12, 2)
  currency            String          @default("USD")
  
  // Dates
  validUntil          DateTime?       @map("valid_until")
  estimatedTransitDays Int?           @map("estimated_transit_days")
  
  // Internal
  internalNotes       String?         @map("internal_notes")
  lossReason          String?         @map("loss_reason")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  customer            Customer        @relation(fields: [customerId], references: [id])
  createdBy           User            @relation(fields: [createdById], references: [id])
  activities          Activity[]

  @@map("quotations")
}

// Activities Table (CRM Activity Feed)
model Activity {
  id              String       @id @default(uuid())
  type            ActivityType
  customerId      String?      @map("customer_id")
  quotationId     String?      @map("quotation_id")
  userId          String       @map("user_id")
  
  // Activity Details
  subject         String?
  description     String?
  dueDate         DateTime?    @map("due_date")
  completedAt     DateTime?    @map("completed_at")
  
  // For calls/meetings
  durationMinutes Int?         @map("duration_minutes")
  
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  customer        Customer?    @relation(fields: [customerId], references: [id])
  quotation       Quotation?   @relation(fields: [quotationId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@map("activities")
}

// Lookup Values Table (for dynamic lists like transport modes, incoterms, etc.)
model LookupValue {
  id          String    @id @default(uuid())
  category    String    // e.g., "transport_mode", "incoterm", "package_type", "cargo_type"
  value       String    // e.g., "AIR", "FCL", "BOX"
  label       String    // e.g., "Air Freight", "Full Container Load", "Box"
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([category, value])
  @@map("lookup_values")
}

// Audit Log Table (for tracking all changes)
model AuditLog {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  action      String    // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  entityType  String    @map("entity_type") // e.g., "customer", "quotation", "user"
  entityId    String?   @map("entity_id")
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User?     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
