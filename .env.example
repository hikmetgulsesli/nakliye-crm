# =====================================================================
# Nakliye CRM - Docker / Dokploy env ornegi
# =====================================================================
# Local icin: `.env` olarak kopyalayin ve gercek degerleri girin.
# Dokploy UI'inda "Environment" sekmesine her degiskeni ayri ayri girin.
# Not: apps/api/.env SADECE local dev (bun run dev:api) icindir,
#      Docker/production bu dosyadaki degiskenleri kullanir.
# ---------------------------------------------------------------------

# --- External PostgreSQL (onerilen) ---
# Dokploy'un kendi managed postgres'i ya da baska bir DB sunucusu
DATABASE_URL=postgresql://nakliyecrm_app:Nkly2026!xRmQ9vBw@72.61.186.46:37550/nakliyecrm_v3

# --- Uygulama portu (host -> container) ---
# Local: http://localhost:3505 ile acilir
# Uzak sunucu: traefik/dokploy domain'i bu porta yonlendirir
APP_PORT=3505

# --- JWT secret'lari (MUTLAKA rastgele ve 32+ karakter) ---
# Terminal: openssl rand -hex 32
JWT_SECRET=REPLACE-WITH-openssl-rand-hex-32-OUTPUT-abcdef1234567890abcdef1234567890
JWT_REFRESH_SECRET=REPLACE-WITH-ANOTHER-openssl-rand-hex-32-fedcba0987654321fedcba0987654321

# --- CORS (frontend domain'i) ---
# Local test: http://localhost:3505
# Production: https://nakliye.setrox.com.tr
CORS_ORIGIN=https://nakliye.setrox.com.tr

# --- Seed (idempotent upsert, default kullanicilari icerir) ---
# 0 = seed calisir (ilk deploy icin gerekli)
# 1 = seed calismaz (ilk deploy sonrasi 1'e cevirip sifre resetlemesini engelleyin)
DISABLE_SEED=0

# =====================================================================
# Opsiyonel: compose icinde postgres de calistirmak isterseniz
# =====================================================================
# docker compose --profile embedded-db up --build
# Bu durumda DATABASE_URL'i yorum satiri yapin; asagidakiler kullanilir.
#
# POSTGRES_USER=nakliye
# POSTGRES_PASSWORD=guclu-bir-sifre
# POSTGRES_DB=nakliye_crm
