# =====================================================================
# Nakliye CRM - Production / Dokploy / Local Docker Env
# =====================================================================
# Local icin: bu dosyayi `.env` olarak kopyalayip degerleri doldurun.
# Dokploy UI'inda "Environment" sekmesine her degiskeni ayri ayri girin.
# (Not: apps/api/.env.example saf API icin ayrica duruyor)
# ---------------------------------------------------------------------

# --- Database (docker-compose icindeki postgres servisi icin) ---
POSTGRES_USER=nakliye
POSTGRES_PASSWORD=guclu-bir-sifre-en-az-16-karakter
POSTGRES_DB=nakliye_crm

# --- Uygulama portu (host -> container) ---
# Local: http://localhost:3505 ile acilir
# Uzak sunucu: traefik/dokploy domain'i bu porta yonlendirir
APP_PORT=3505

# --- JWT secret'lari (MUTLAKA degistirin, min 32 karakter) ---
# openssl rand -hex 32 komutuyla uretebilirsiniz
JWT_SECRET=change-me-at-least-32-chars-random-hex-abcdef1234567890
JWT_REFRESH_SECRET=change-me-different-32-chars-random-hex-fedcba0987654321

# --- CORS (frontend'in eristigi domain) ---
# Local test: http://localhost:3505
# Production: https://nakliye.setrox.com.tr
CORS_ORIGIN=https://nakliye.setrox.com.tr

# --- Seed (idempotent upsert, default sifreler icerir) ---
# 0 = seed calisir (ilk acilis icin gerekli)
# 1 = seed calismaz (production'da 2. deploy'dan itibaren 1 yapin)
DISABLE_SEED=0
