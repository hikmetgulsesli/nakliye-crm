generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  avatarUrl    String?  @map("avatar_url")
  phone        String?
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  notificationPrefs Json? @map("notification_prefs")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedCustomers  Customer[]          @relation("AssignedUser")
  createdCustomers   Customer[]          @relation("CreatedByUser")
  assignedQuotations Quotation[]         @relation("AssignedQuoteUser")
  createdQuotations  Quotation[]         @relation("CreatedQuoteUser")
  activities         Activity[]
  revisions          QuotationRevision[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Customer {
  id                   Int       @id @default(autoincrement())
  companyName          String    @map("company_name")
  contactName          String?   @map("contact_name")
  phone                String
  email                String
  address              String?
  transportModes       Json?     @map("transport_modes")
  serviceTypes         Json?     @map("service_types")
  incoterms            Json?
  direction            String?
  originCountries      Json?     @map("origin_countries")
  destinationCountries Json?     @map("destination_countries")
  source               String?
  potential            String?
  status               String    @default("Aktif")
  notes                String?
  assignedUserId       Int       @map("assigned_user_id")
  assignedUser         User      @relation("AssignedUser", fields: [assignedUserId], references: [id])
  lastContactDate      DateTime? @map("last_contact_date")
  lastInboundAt        DateTime? @map("last_inbound_at")
  lastQuoteDate        DateTime? @map("last_quote_date")
  createdById          Int       @map("created_by")
  createdBy            User      @relation("CreatedByUser", fields: [createdById], references: [id])
  isDeleted            Boolean   @default(false) @map("is_deleted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  quotations Quotation[]
  activities Activity[]
  shipments  Shipment[]
  contacts   CustomerContact[]

  @@map("customers")
}

model Quotation {
  id                 Int       @id @default(autoincrement())
  quoteNo            String    @unique @map("quote_no")
  customerId         Int       @map("customer_id")
  customer           Customer  @relation(fields: [customerId], references: [id])
  quoteDate          DateTime  @map("quote_date")
  validityDate       DateTime  @map("validity_date")
  transportMode      String?   @map("transport_mode")
  serviceType        String?   @map("service_type")
  originCountry      String?   @map("origin_country")
  pol                String?
  destinationCountry String?   @map("destination_country")
  pod                String?
  incoterm           String?
  price              Decimal?  @db.Decimal(12, 2)
  currency           String?   @default("USD")
  priceNote          String?   @map("price_note")
  status             String    @default("Bekliyor")
  lossReason         String?   @map("loss_reason")
  assignedUserId     Int       @map("assigned_user_id")
  assignedUser       User      @relation("AssignedQuoteUser", fields: [assignedUserId], references: [id])
  revisionCount      Int       @default(0) @map("revision_count")
  createdById        Int       @map("created_by")
  createdBy          User      @relation("CreatedQuoteUser", fields: [createdById], references: [id])
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  revisions QuotationRevision[]

  @@map("quotations")
}

model QuotationRevision {
  id            Int       @id @default(autoincrement())
  quotationId   Int       @map("quotation_id")
  quotation     Quotation @relation(fields: [quotationId], references: [id])
  revisionNo    Int       @map("revision_no")
  changedFields Json      @map("changed_fields")
  revisedById   Int       @map("revised_by")
  revisedBy     User      @relation(fields: [revisedById], references: [id])
  revisedAt     DateTime  @default(now()) @map("revised_at")

  @@map("quotation_revisions")
}

model Activity {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  customer        Customer  @relation(fields: [customerId], references: [id])
  activityType    String    @map("activity_type")
  activityDate    DateTime  @map("activity_date")
  durationMinutes Int?      @map("duration_minutes")
  notes           String?
  outcome         String?
  nextActionDate  DateTime? @map("next_action_date")
  createdById     Int       @map("created_by")
  createdBy       User      @relation(fields: [createdById], references: [id])
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("activities")
}

model LookupValue {
  id        Int      @id @default(autoincrement())
  category  String
  value     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, value])
  @@map("lookup_values")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  recordType String   @map("record_type")
  recordId   Int      @map("record_id")
  action     String
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([recordType, recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// Admin UI'dan yonetilen sistem ayarlari. API key vb. hassas degerler env'de
// tutulmaya devam eder; burada sadece "enabled/disabled", "default provider",
// "threshold" gibi UI'dan degistirilebilir non-sensitive ayarlar.
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

// Komisyon kurali — kazanilan teklif basina temsilciye verilecek %
model CommissionRule {
  id         Int       @id @default(autoincrement())
  name       String
  userId     Int?      @map("user_id")
  percent    Float
  minAmount  Float?    @map("min_amount")
  maxAmount  Float?    @map("max_amount")
  currency   String?
  validFrom  DateTime  @map("valid_from")
  validUntil DateTime? @map("valid_until")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("commission_rules")
}

// Rozet tanimi (otomatik verilir)
model Badge {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  name        String
  description String?
  icon        String?
  criteria    Json
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  awards UserBadge[]

  @@map("badges")
}

// Kullaniciya verilmis rozet
model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  badgeId   Int      @map("badge_id")
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now()) @map("awarded_at")

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// Hedef (kisisel veya ekip)
model SalesGoal {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  metric      String // quote_count | won_count | revenue | activity_count
  target      Float
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  notes       String?
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, periodEnd])
  @@map("sales_goals")
}

// Müşteri firmasında birden çok yetkili (contact kişi)
model CustomerContact {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName        String    @map("full_name")
  role            String? // Operasyon / Muhasebe / Satın Alma vb.
  phone           String?
  email           String?
  birthdate       DateTime? // gun.ay bazinda — yil opsiyonel ama tutuyoruz
  notes           String?
  isPrimary       Boolean   @default(false) @map("is_primary")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([email])
  @@map("customer_contacts")
}

// Mesaj sablonu (WhatsApp/SMS/E-posta ortak) — {musteri_adi} gibi
// degisken interpolasyonlu
model MessageTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  channel     String // whatsapp | sms | email
  subject     String? // sadece email
  body        String
  variables   Json? // [{key: "musteri_adi", label: "Müşteri Adı"}]
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([channel, isActive])
  @@map("message_templates")
}

// Nakliye sevkiyat modulu — teklif "Kazanildi" olunca otomatik olusur
model Shipment {
  id                 Int       @id @default(autoincrement())
  shipmentNo         String    @unique @map("shipment_no")
  quotationId        Int?      @map("quotation_id")
  customerId         Int       @map("customer_id")
  customer           Customer  @relation(fields: [customerId], references: [id])
  blNumber           String?   @map("bl_number")
  awbNumber          String?   @map("awb_number")
  transportMode      String?   @map("transport_mode")
  serviceType        String?   @map("service_type")
  originCountry      String?   @map("origin_country")
  pol                String?
  destinationCountry String?   @map("destination_country")
  pod                String?
  etd                DateTime?
  eta                DateTime?
  atd                DateTime?
  ata                DateTime?
  status             String    @default("booked")
  customsStatus      String?   @map("customs_status")
  notes              String?
  assignedUserId     Int       @map("assigned_user_id")
  createdById        Int       @map("created_by_id")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  containers Container[]
  events     ShipmentEvent[]

  @@index([customerId])
  @@index([status])
  @@index([assignedUserId])
  @@map("shipments")
}

model Container {
  id          Int      @id @default(autoincrement())
  shipmentId  Int      @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerNo String   @map("container_no")
  sealNo      String?  @map("seal_no")
  type        String?
  weightKg    Float?   @map("weight_kg")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shipmentId])
  @@map("containers")
}

model ShipmentEvent {
  id          Int      @id @default(autoincrement())
  shipmentId  Int      @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventType   String   @map("event_type")
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  note        String?
  location    String?
  occurredAt  DateTime @map("occurred_at")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model Document {
  id           Int      @id @default(autoincrement())
  ownerType    String   @map("owner_type")
  ownerId      Int      @map("owner_id")
  category     String
  filename     String
  storageKey   String   @map("storage_key")
  contentType  String?  @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  version      Int      @default(1)
  uploadedById Int      @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@index([category])
  @@map("documents")
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  date      DateTime
  currency  String
  buying    Float
  selling   Float
  source    String   @default("TCMB")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, currency])
  @@index([currency, date])
  @@map("exchange_rates")
}

model Carrier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique
  modes     Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  rates Rate[]

  @@map("carriers")
}

model Rate {
  id                 Int       @id @default(autoincrement())
  carrierId          Int       @map("carrier_id")
  carrier            Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  transportMode      String    @map("transport_mode")
  serviceType        String?   @map("service_type")
  originCountry      String?   @map("origin_country")
  pol                String?
  destinationCountry String?   @map("destination_country")
  pod                String?
  basePrice          Float     @map("base_price")
  currency           String    @default("USD")
  validFrom          DateTime  @map("valid_from")
  validUntil         DateTime? @map("valid_until")
  notes              String?
  isActive           Boolean   @default(true) @map("is_active")
  createdById        Int       @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([carrierId, transportMode])
  @@index([originCountry, destinationCountry])
  @@index([validFrom, validUntil])
  @@map("rates")
}

model SavedView {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  resource  String
  filters   Json
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, resource])
  @@map("saved_views")
}

model InternalNote {
  id               Int      @id @default(autoincrement())
  ownerType        String   @map("owner_type")
  ownerId          Int      @map("owner_id")
  authorId         Int      @map("author_id")
  content          String
  mentionedUserIds Int[]    @map("mentioned_user_ids")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@map("internal_notes")
}

// Musteri kaybetme riski (nightly cron ile hesaplanir)
model ChurnRisk {
  id          Int      @id @default(autoincrement())
  customerId  Int      @unique @map("customer_id")
  score       Int // 0-100
  level       String // 'low' | 'medium' | 'high' | 'critical'
  signals     Json // [{name, impact, detail}]
  computedAt  DateTime @default(now()) @map("computed_at")

  @@index([score])
  @@index([level])
  @@map("churn_risk")
}

// AI API cagri kayitlari — cost tracking + analiz
model AIUsage {
  id               Int      @id @default(autoincrement())
  provider         String
  model            String
  task             String?
  userId           Int?     @map("user_id")
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  costUsd          Float    @map("cost_usd")
  latencyMs        Int      @map("latency_ms")
  success          Boolean  @default(true)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@index([task, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}
